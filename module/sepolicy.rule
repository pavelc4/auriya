# Auriya Manager Direct IPC Socket SELinux Policy Rules

# Multi-Level Security (MLS) exemption for untrusted app categories
typeattribute socket_device mlstrustedobject

# Directory traversal & socket node permissions
allow untrusted_app socket_device dir { search getattr }
allow untrusted_app socket_device sock_file { write getattr open read }
allow untrusted_app_all socket_device dir { search getattr }
allow untrusted_app_all socket_device sock_file { write getattr open read }

# UNIX stream socket connection to root domains (KernelSU, Magisk)
allow untrusted_app ksu unix_stream_socket connectto
allow untrusted_app magisk unix_stream_socket connectto
allow untrusted_app su unix_stream_socket connectto

allow untrusted_app_all ksu unix_stream_socket connectto
allow untrusted_app_all magisk unix_stream_socket connectto
allow untrusted_app_all su unix_stream_socket connectto
