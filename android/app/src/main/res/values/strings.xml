    <string name="config_dynamic_gov_info_title">Dynamic Governor Switching</string>
    <string name="config_dynamic_gov_info_desc">Detects micro-stutter and frame time variance. When jitter exceeds the CV threshold for consecutive debounce frames, Auriya temporarily switches to an aggressive governor to smooth out spikes.</string>
