    <string name="config_cpu_info_desc">Governors dictate how the Linux kernel scales CPU clock speeds between idle and load. Tap below to choose or inspect active scaling governors.</string>

    <string name="config_sec_dnd_auto">DND AUTOMATION</string>
    <string name="config_dnd_info_title">Do Not Disturb (DND)</string>
    <string name="config_dnd_info_desc">Automatically silences notifications, pop-up banners, and call rings whenever a listed game enters the foreground, restoring normal state on exit.</string>
