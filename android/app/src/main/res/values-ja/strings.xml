    <string name="config_debounce_frames">Debounce Frames</string>
    <string name="config_debounce_frames_desc">Consecutive jitter frames required to switch</string>
    <string name="config_sec_fas">FAS CONFIGURATION</string>
    <string name="config_fas_info_title">Frame-Aware Scheduling</string>
    <string name="config_fas_info_desc">FAS calculates real-time frametimes from SurfaceFlinger or eBPF. It scales frequencies up when frames drop and lowers them during calm scenes to prevent thermal throttling.</string>
    <string name="config_fas_enable">Enable FAS Engine</string>
    <string name="config_fas_enable_desc">Adaptive frame regulator for steady frame rates</string>
